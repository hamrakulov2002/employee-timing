<Window x:Class="ZKTECO_LIVE20R.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Электронный Терминал Mangal Burger" Height="550" Width="900"
        WindowStartupLocation="CenterScreen" Background="#121A22"
        WindowState="Maximized"
        WindowStyle="None"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Цвета -->
        <SolidColorBrush x:Key="CardBrush" Color="#1E2B38"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#2E3F50"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8FA1B3"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#F39C12"/>

        <!-- Тень для карточек -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="25" ShadowDepth="4" Direction="270" Opacity="0.35" Color="Black"/>

        <!-- Кнопка администратора -->
        <Style x:Key="AdminButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#566573"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" Background="Transparent" CornerRadius="8"
                                BorderBrush="Transparent" BorderThickness="1" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E2B38"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2E3F50"/>
                                <Setter Property="Foreground" Value="#C5CED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Элемент списка истории -->
        <Style x:Key="LogItemStyle" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Name="bd" Background="Transparent" CornerRadius="8" Margin="0,0,0,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26364A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2B3F57"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1.8*"/>
        </Grid.ColumnDefinitions>

        <!-- Шапка -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,25" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="6" Height="32" CornerRadius="3" Background="{StaticResource AccentBrush}" Margin="0,0,14,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ТЕРМИНАЛ УЧЕТА РАБОЧЕГО ВРЕМЕНИ" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Mangal Burger" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <Button DockPanel.Dock="Right" Command="{Binding OpenAdminPanelCommand}" Content="⚙ Регистрация (Админ)"
                    Style="{StaticResource AdminButtonStyle}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Панель: приложите палец + результат последней отметки -->
        <Border Grid.Row="1" Grid.Column="0" Margin="0,0,25,0" VerticalAlignment="Center"
                Background="{StaticResource CardBrush}" CornerRadius="18" Padding="28"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                Effect="{StaticResource CardShadow}">
            <StackPanel>
                <TextBlock Text="👆" FontSize="64" HorizontalAlignment="Center"/>
                <TextBlock Text="ПРИЛОЖИТЕ ПАЛЕЦ" FontSize="30" FontWeight="Black" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock Text="Приход или уход определяется автоматически"
                           FontSize="14" Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,12,0,0"/>

                <Border Margin="0,28,0,0" CornerRadius="14" Padding="16"
                        Background="{Binding LastActionBrush}">
                    <StackPanel>
                        <TextBlock Text="{Binding LastActionTitle}" FontSize="26" FontWeight="Black"
                                   Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding LastActionName}" FontSize="16" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- История проходов -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="18" Padding="22"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Text="🕒" FontSize="16" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Последние отметки" Foreground="#C5CED8" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding LiveLogs}" Background="Transparent" BorderThickness="0" FontSize="14"
                         ItemContainerStyle="{StaticResource LogItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#2E3F50" BorderThickness="0,0,0,1" Padding="12,10,12,10">
                                <TextBlock Text="{Binding}" Foreground="#ECF0F1" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Строка состояния -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="0,25,0,0" Background="#0D1319" CornerRadius="12"
                BorderBrush="#222F3C" BorderThickness="1" Padding="16,10">
            <StatusBar Background="Transparent" Foreground="{StaticResource AccentBrush}" Padding="0">
                <TextBlock Text="{Binding StatusMessage}" FontSize="14" FontWeight="SemiBold"/>
            </StatusBar>
        </Border>
    </Grid>
</Window>
