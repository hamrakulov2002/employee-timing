@model IEnumerable<ZKTECO_LIVE20R.Models.AttendanceLog>
@{
    Layout = null;
    var emp = ViewBag.Employee as ZKTECO_LIVE20R.Models.Employee;
    int currentYear = ViewBag.Year;
    int currentMonth = ViewBag.Month;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Отчет по сотруднику — ZKAccess</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body class="bg-light">
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-0 text-dark">👤 Отчет: @emp?.FullName</h1>
                <p class="text-muted">Должность: @emp?.Position | Период: @currentMonth.@currentYear</p>
            </div>
            <div>
                <a href="/Admin/Index" class="btn btn-outline-secondary shadow-sm">
                    <i class="bi bi-arrow-left"></i> К списку
                </a>
            </div>
        </div>

        <!-- Фильтр -->
        <div class="card shadow-sm border-0 rounded-4 mb-4">
            <div class="card-body">
                <form method="get" action="/Admin/EmployeeReport/@emp?.Id" class="row g-3 align-items-center">
                    <div class="col-auto">
                        <label class="form-label fw-semibold mb-0">Месяц:</label>
                    </div>
                    <div class="col-auto">
                        <select name="month" class="form-select">
                            @for (int m = 1; m <= 12; m++)
                            {
                                <option value="@m" selected="@(m == currentMonth)">@m</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <label class="form-label fw-semibold mb-0">Год:</label>
                    </div>
                    <div class="col-auto">
                        <select name="year" class="form-select">
                            @for (int y = 2025; y <= 2030; y++)
                            {
                                <option value="@y" selected="@(y == currentYear)">@y</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">Показать</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Таблица посещений -->
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="ps-4">Дата и время</th>
                                <th class="text-end pe-4">Статус</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="2" class="text-center py-4 text-muted">За этот месяц записей о посещениях нет.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var log in Model)
                                {
                                    <tr>
                                        <td class="ps-4 text-secondary">
                                            <i class="bi bi-clock"></i> @log.Timestamp.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")
                                        </td>
                                        <td class="text-end pe-4">
                                            @if (log.IsCheckIn)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2">ПРИХОД</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2">УХОД</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</body>
</html>