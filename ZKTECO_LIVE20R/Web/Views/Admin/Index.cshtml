@model IEnumerable<ZKTECO_LIVE20R.Models.Employee>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Управление персоналом — ZKAccess</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body class="bg-light">

    <!-- ПОСТОЯННЫЙ HEADER (ШАПКА) -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/Admin/Index">
                <i class="bi bi-shield-lock-fill text-success"></i> ZKAccess Admin
            </a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link active" href="/Admin/Index">
                            <i class="bi bi-house-door"></i> Главная (Статус)
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Admin/MonthlyReport">
                            <i class="bi bi-file-earmark-text"></i> Общий отчет за месяц
                        </a>
                    </li>
                    <li class="nav-item ms-3">
                        <a href="/Admin/Create" class="btn btn-success btn-sm text-white mt-1">
                            <i class="bi bi-person-plus"></i> Добавить сотрудника
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- ОСНОВНОЙ КОНТЕНТ -->
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-0 text-dark">📊 Мониторинг сотрудников</h1>
                <p class="text-muted">Текущий статус присутствия на рабочем месте</p>
            </div>
        </div>

        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="ps-4">ФИО сотрудника</th>
                                <th>Должность</th>
                                <th>Статус сегодня</th>
                                <th>Отпечатков</th>
                                <th class="text-end pe-4">Действия (Отчеты / Оплата)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">Сотрудники не найдены.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var emp in Model)
                                {
                                    // Определяем, на работе ли сотрудник по последнему логу за сегодня
                                    var lastLog = emp.AttendanceLogs?.OrderByDescending(l => l.Timestamp).FirstOrDefault();
                                    bool isAtWork = lastLog != null && lastLog.IsCheckIn;

                                    <tr>
                                        <td class="ps-4 fw-semibold text-dark">@emp.FullName</td>
                                        <td>
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary">
                                                @(string.IsNullOrEmpty(emp.Position) ? "Не указана" : emp.Position)
                                            </span>
                                        </td>
                                        <td>
                                            @if (isAtWork)
                                            {
                                                <span class="badge bg-success px-3 py-2">
                                                    <i class="bi bi-check-circle-fill"></i> На месте (с @lastLog.Timestamp.ToLocalTime().ToString("HH:mm"))
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2">
                                                    <i class="bi bi-x-circle"></i> Отсутствует
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-success bg-opacity-10 text-success px-2 py-1">
                                                <i class="bi bi-fingerprint"></i> @emp.FingerPrints.Count
                                            </span>
                                        </td>
                                        <td class="text-end pe-4">
                                            <!-- Кнопка часов и отчета за месяц -->
                                            <a href="/Admin/EmployeeReport/@emp.Id" class="btn btn-outline-info btn-sm me-1" title="Часы работы и отчет">
                                                <i class="bi bi-clock-history"></i> Часы и отчет
                                            </a>
                                            <!-- Кнопка расчета аванса / зарплаты за период -->
                                            <a href="/Admin/Payroll/@emp.Id" class="btn btn-outline-warning btn-sm me-1" title="Аванс и недельная оплата">
                                                <i class="bi bi-cash-coin"></i> Оплата / Аванс
                                            </a>
                                            <!-- Редактировать -->
                                            <a href="/Admin/Edit/@emp.Id" class="btn btn-outline-primary btn-sm me-1" title="Редактировать">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <!-- Удалить -->
                                            <form action="/Admin/Delete/@emp.Id" method="post" class="d-inline" onsubmit="return confirm('Удалить сотрудника @emp.FullName?');">
                                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Удалить">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</body>
</html>