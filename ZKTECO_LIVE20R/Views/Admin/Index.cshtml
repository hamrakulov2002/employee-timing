@model IEnumerable<ZKTECO_LIVE20R.Models.Employee>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Управление сотрудниками — ZKAccess</title>
    <!-- Подключаем Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body class="bg-light">
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-0 text-dark">👥 Управление сотрудниками</h1>
                <p class="text-muted">Терминал учёта рабочего времени</p>
            </div>
            <div>
                <a href="/Admin/MonthlyReport" class="btn btn-outline-primary shadow-sm">
                    <i class="bi bi-file-earmark-text"></i> Отчет за месяц
                </a>
            </div>
        </div>

        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="ps-4">ФИО сотрудника</th>
                                <th>Должность</th>
                                <th>Отпечатков в базе</th>
                                <th class="text-end pe-4">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">Сотрудники пока не зарегистрированы.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var emp in Model)
                                {
                                    <tr>
                                        <td class="ps-4 fw-semibold text-dark">@emp.FullName</td>
                                        <td>
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary">
                                                @(string.IsNullOrEmpty(emp.Position) ? "Не указана" : emp.Position)
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge bg-success bg-opacity-10 text-success px-2 py-1">
                                                <i class="bi bi-fingerprint"></i> @emp.FingerPrints.Count
                                            </span>
                                        </td>
                                        <td class="text-end pe-4">
                                            <form asp-action="Delete" asp-route-id="@emp.Id" method="post" class="d-inline" onsubmit="return confirm('Вы уверены, что хотите удалить сотрудника @emp.FullName?');">
                                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                                    <i class="bi bi-trash"></i> Удалить
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</body>
</html>