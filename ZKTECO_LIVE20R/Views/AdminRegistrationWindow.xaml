<Window x:Class="ZKTECO_LIVE20R.Views.AdminRegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель Администратора — Регистрация Биометрии" Height="350" Width="400" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock Text="Регистрация нового сотрудника" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
        <TextBlock Text="ФИО:"/>
        <TextBox Name="TxtName" Height="30" Margin="0,5,0,10"/>
        <TextBlock Text="Должность:"/>
        <TextBox Name="TxtPosition" Height="30" Margin="0,5,0,15"/>
        <TextBlock Name="TxtStatus" Text="Приложите палец к сканеру для захвата..." Foreground="#E67E22" FontWeight="Bold" Margin="0,0,0,15"/>
        <Button Content="Сохранить сотрудника в PostgreSQL" Click="Save_Click" Height="40" Background="#2ECC71" Foreground="White" FontWeight="Bold"/>
    </StackPanel>
</Window>