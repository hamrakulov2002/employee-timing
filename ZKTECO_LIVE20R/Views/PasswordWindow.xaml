<Window x:Class="ZKTECO_LIVE20R.Views.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Доступ ограничен" Height="180" Width="350" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock Text="Введите пароль администратора:" FontWeight="Bold" Margin="0,0,0,10"/>
        <PasswordBox Name="TxtPassword" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,15"/>
        <Button Content="Войти" Click="Login_Click" Height="30" Background="#34495E" Foreground="White" IsDefault="True"/>
    </StackPanel>
</Window>